{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=JobMarketDev;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "JobMarketAPI",
    "Audience": "JobMarketClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "OpenAi": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "EmbeddingModel": "text-embedding-3-small",
    "ChatModel": "gpt-4o-mini"
  },
  "Scrapers": {
    "MaxPagesPerSource": 5,
    "RequestDelayMs": 500,
    "AdzunaAppId": "YOUR_ADZUNA_APP_ID",
    "AdzunaApiKey": "YOUR_ADZUNA_API_KEY"
  },
  "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
}
